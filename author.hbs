{{!< default}} <section class="author-page">

    {{#author}}
    <!-- Author Profile Card -->
    <div class="author-card">
        <div class="author-avatar-wrapper">
            {{#if profile_image}}
            <img class="author-avatar" src="{{profile_image}}" alt="{{name}}">
            {{else}}
            <div class="author-avatar author-avatar-fallback">
                <span class="author-initial">{{name.[0]}}</span>
            </div>
            {{/if}}
        </div>

        <div class="author-details">
            <h1 class="author-name">{{name}}</h1>

            {{#if bio}}
            <p class="author-bio">{{bio}}</p>
            {{/if}}

            <div class="author-stats">
                <div class="author-stat">
                    <span class="author-stat-value">{{../pagination.total}}</span>
                    <span class="author-stat-label">posts</span>
                </div>

                {{#if location}}
                <span class="author-stat-divider">•</span>
                <div class="author-stat">
                    <span class="author-stat-value">{{location}}</span>
                </div>
                {{/if}}

                {{#if website}}
                <span class="author-stat-divider">•</span>
                <a href="{{website}}" class="author-stat-link" target="_blank" rel="noopener">Website</a>
                {{/if}}
            </div>
        </div>
    </div>
    {{/author}}

    <!-- Author Posts -->
    <section class="author-posts">
        <h2 class="author-posts-title">Articles by {{author.name}}</h2>

        {{#if posts}}
        <div class="post-grid">
            {{#foreach posts}}
            <article class="post-card {{post_class}}">
                <a href="{{url}}" class="post-card-link">
                    {{#if feature_image}}
                    <div class="post-card-image" style="background-image: url('{{feature_image}}');"></div>
                    {{else}}
                    <div class="post-card-image post-card-no-image"></div>
                    {{/if}}

                    <div class="post-card-overlay"></div>

                    <div class="post-card-content">
                        {{#if tags}}
                        <div class="post-card-tags">
                            {{#foreach tags limit="2"}}
                            <span class="post-card-tag" {{#if accent_color}}style="background-color: {{accent_color}};"
                                {{/if}}>{{name}}</span>
                            {{/foreach}}
                        </div>
                        {{/if}}
                        <h3 class="post-card-title">{{title}}</h3>
                        <p class="post-card-excerpt">{{excerpt words="15"}}</p>
                    </div>
                </a>
            </article>
            {{/foreach}}
        </div>

        {{!-- Ghost Native Pagination --}}
        {{#if pagination.next}}
        <nav class="pagination" role="navigation" aria-label="Pagination">
            {{#if pagination.prev}}
            <a class="pagination-prev" href="{{page_url pagination.prev}}" aria-label="Previous page">← Newer</a>
            {{/if}}

            <span class="pagination-info">Page {{pagination.page}} of {{pagination.pages}}</span>

            <a class="pagination-next" href="{{page_url pagination.next}}" aria-label="Next page">Older →</a>
        </nav>
        {{else}}
        {{#if pagination.prev}}
        <nav class="pagination" role="navigation" aria-label="Pagination">
            <a class="pagination-prev" href="{{page_url pagination.prev}}" aria-label="Previous page">← Newer</a>
            <span class="pagination-info">Page {{pagination.page}} of {{pagination.pages}}</span>
        </nav>
        {{/if}}
        {{/if}}

        {{else}}
        <div class="no-posts">
            <div class="no-posts-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
            </div>
            <h3 class="no-posts-title">No posts published yet</h3>
            <p class="no-posts-message">Check back soon for new content.</p>
        </div>
        {{/if}}
    </section>

    </section>